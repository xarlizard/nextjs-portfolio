{
  "name": "portfolio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "author": {
    "name": "Charlie Rios",
    "url": "https://github.com/xarlizard"
  },
  "homepage": "https://charlie.icu",
  "repository": {
    "type": "git",
    "url": "https://github.com/xarlizard/nextjs-portfolio.git"
  },
  "packageManager": "bun@1.3.14",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "upload": "opennextjs-cloudflare build && opennextjs-cloudflare upload",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "clean": "rm -rf .next .open-next",
    "vercel-deploy": "vercel deploy --prod",
    "vercel-install": "bun install --ignore-scripts",
    "vercel-build": "bun remove @cloudflare/workerd-linux-64 @opennextjs/cloudflare && next build",
    "build:cloudflare": "opennextjs-cloudflare build"
  },
  "dependencies": {
    "@opennextjs/cloudflare": "^1.20.4",
    "@react-email/components": "^1.0.12",
    "@react-email/tailwind": "^2.0.7",
    "clsx": "^2.1.1",
    "framer-motion": "^12.23.12",
    "next": "16.3.3",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-hot-toast": "^2.6.0",
    "react-icons": "^5.5.0",
    "react-intersection-observer": "^9.16.0",
    "resend": "^6.24.0"
  },
  "devDependencies": {
    "@types/node": "^22.15.30",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "autoprefixer": "^10.4.21",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.3.3",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.8.3",
    "wrangler": "^4.127.0"
  }
}
